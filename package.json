{
  "name": "orbitylabs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "bin": {
    "orbitylabs-connect": "bin/orbitylabs-connect.mjs",
    "orbitylabs": "bin/orbitylabs.mjs"
  },
  "scripts": {
    "dev": "vite",
    "server": ".venv/bin/uvicorn hermes_jarvis.app:app --app-dir backend --host 0.0.0.0 --port 8787 --reload",
    "build": "vite build",
    "start": ".venv/bin/uvicorn hermes_jarvis.app:app --app-dir backend --host 0.0.0.0 --port 8787",
    "preview": "vite preview",
    "test": "vitest run",
    "hermes:connect": "python3 scripts/connect-hermes.py",
    "desktop:dev": "electron .",
    "desktop:package": "node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@vitejs/plugin-react": "latest",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "latest",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.orbitylabs.commandcentre",
    "productName": "OrbityLabs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/mac-*/**/*",
      "!dist/builder-*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "desktop-build/hermes-jarvis-server",
        "to": "server/hermes-jarvis-server"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
